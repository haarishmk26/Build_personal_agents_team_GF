# Browser-safe configuration
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-url
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only configuration (inject from Kubernetes Secret in production)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_JWKS_URL=https://your-neon-auth-url/.well-known/jwks.json
NEON_AI_GATEWAY_BASE_URL=https://your-neon-ai-gateway-host
NEON_AI_GATEWAY_TOKEN=your_ai_gateway_token
NEON_AI_GATEWAY_MODEL=gpt-5-mini
AGENTMAIL_API_KEY=your_agentmail_api_key
AGENTMAIL_INBOX=haarish-agent@agentmail.to
API_PORT=4000
WEB_ORIGIN=http://localhost:3000